{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure (debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "msvc-x64-debug"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "CMake: build (debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-x64-debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "CMake: build (release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-x64-release"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Test: unit (no PLCSIM needed)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "unit"],
      "dependsOn": "CMake: build (debug)",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Test: live (needs a running instance)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "live"],
      "dependsOn": "CMake: build (debug)",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Python: install into the active interpreter",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-e", ".", "--no-build-isolation"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Python: list registered PLC instances",
      "detail": "Quick smoke test that the Runtime Manager is reachable",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "plcsim_connector"],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/build/msvc-x64-debug/python"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: clean build tree",
      "type": "shell",
      "command": "cmake",
      "args": ["-E", "rm", "-rf", "${workspaceFolder}/build"],
      "problemMatcher": []
    }
  ]
}
