{
  // ---------------------------------------------------------------------
  // CMake Tools
  // ---------------------------------------------------------------------
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
  "cmake.ctest.testExplorerIntegrationEnabled": true,
  // Live tests need a running PLC instance, so keep them out of the default
  // "Run All Tests" click. Use the "live" test preset when you want them.
  "cmake.ctestDefaultArgs": ["--label-exclude", "live", "--output-on-failure"],

  // ---------------------------------------------------------------------
  // C/C++ IntelliSense - driven by CMake Tools, not by hand-maintained paths
  // ---------------------------------------------------------------------
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.autoAddFileAssociations": false,

  // ---------------------------------------------------------------------
  // Python
  // ---------------------------------------------------------------------
  // The extension module is built into build/<preset>/python; pointing the
  // analyser there makes `import plcsim_connector` resolve without installing.
  "python.analysis.extraPaths": [
    "${workspaceFolder}/build/msvc-x64-debug/python",
    "${workspaceFolder}/bindings/python"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,

  // ---------------------------------------------------------------------
  // Editor
  // ---------------------------------------------------------------------
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" },
  "[cmake]": { "editor.defaultFormatter": "josetr.cmake-language-support-vscode" },

  "files.associations": {
    "*.hpp": "cpp",
    "*.pyi": "python"
  },

  "files.exclude": {
    "**/build": true,
    "**/install": true,
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "**/build": true,
    "**/install": true
  }
}
